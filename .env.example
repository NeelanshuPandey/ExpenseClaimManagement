# Local Docker Compose settings. Copy this file to .env and replace every placeholder.
# Keep .env private; it contains credentials and is ignored by Git.
DB_PASSWORD=replace-with-a-strong-database-password
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace-with-a-unique-long-password
# Generate with: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-at-least-32-random-bytes